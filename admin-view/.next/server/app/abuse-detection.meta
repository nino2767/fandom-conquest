{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/abuse-detection/layout,_N_T_/abuse-detection/page,_N_T_/abuse-detection"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/abuse-detection/__PAGE__",
    "/abuse-detection",
    "/_index",
    "/_head"
  ]
}